# PostgreSQL connection used by the Next.js runtime and Drizzle Kit.
DATABASE_URL=

# A random secret of at least 32 characters, used to sign Wrapy session cookies.
JWT_SECRET=

# Supabase Storage. Keep the service role key server-only; never add NEXT_PUBLIC_ to it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=wrapy-assets
SUPABASE_AVATAR_BUCKET=wrapy-avatars

# Optional Google sign-in. Configure the callback URL for each deployment origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
